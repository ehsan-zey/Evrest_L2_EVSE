# Copy to .env and change every value before running anywhere real.
PORT=9220              # OCPP WebSocket listener (chargers connect here)
API_PORT=9221          # REST + WebSocket API (dashboard and mobile app)
DB_PATH=./evrest.db
JWT_SECRET=change-me-to-a-long-random-string
# Require chargers to present HTTP Basic credentials (OCPP security profile 1).
# Leave false only on an isolated bench network.
REQUIRE_CHARGER_AUTH=true
